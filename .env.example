# Copy to .env.local and fill in. Never commit .env.local.

# PostgreSQL. DB_ADMIN_URL is only used by `npm run db:setup` to create the database.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/hvac_boq
DB_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/postgres

# Automated database tests (npm run test:db). They delete data, so they require a SEPARATE database whose name
# ends in _test; the suite refuses to run against DATABASE_URL.
TEST_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/hvac_boq_test

# Where `npm run db:setup` writes the pre-migration dump. Must be OUTSIDE this folder (a dump holds password
# hashes and encrypted tokens). Defaults to ../technocool-backups.
# BACKUP_DIR=D:\backups\technocool

# Public address of the app (used for cookie security and the CSRF origin check).
APP_URL=http://localhost:3000

# Where generated Excel files are kept (private folder, never served directly).
STORAGE_DIR=./storage

# 32 random bytes, base64 (npm run gen-secret). Encrypts the Gmail refresh token (AES-256-GCM).
GMAIL_TOKEN_KEY=

# Phase 4: Google Cloud OAuth client (Web application) for the boss Gmail.
# Preferred: paste these into Admin -> Gmail in the app and press Save (the secret is stored encrypted).
# The values here are only a fallback when nothing is saved in the app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback

# Optional: the company Gmail. If set (here or in the app), connecting any other Google account is refused.
GMAIL_ADDRESS=

# Recipients per day before Send is blocked (free Gmail allows about 500).
MAIL_DAILY_RECIPIENT_LIMIT=450

# Phase 5. Replies are checked every REPLY_POLL_SECONDS (default 90). Optional instant push via Google Pub/Sub:
# topic projects/<project>/topics/<name>, push URL <APP_URL>/api/integrations/gmail/push?token=<GMAIL_PUSH_TOKEN> (needs public HTTPS).
REPLY_POLL_SECONDS=90
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_TOKEN=
