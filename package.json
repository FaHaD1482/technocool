{
  "name": "hvac-boq-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:setup": "tsx --env-file=.env.local scripts/db-setup.ts",
    "db:setup:test": "tsx --env-file=.env.local scripts/db-setup.ts --no-backup --force",
    "db:status": "tsx --env-file=.env.local scripts/db-setup.ts --status",
    "create-admin": "tsx --env-file=.env.local scripts/create-admin.ts",
    "gen-secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "worker": "tsx --env-file=.env.local src/worker/index.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "5.1.0"
  }
}
